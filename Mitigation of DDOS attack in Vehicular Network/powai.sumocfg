<?xml version="1.0" encoding="UTF-8"?>
<!-- SUMO configuration for the Powai (Mumbai) map. All files are in this same folder. -->
<sumoConfiguration>
    <input>
        <!-- Real Powai roads from OpenStreetMap (3.4 km x 2.5 km, left-hand driving) -->
        <net-file value="osm.net.xml.gz"/>
        <!-- About 1560 random car trips over 1 hour (generated by OSM Web Wizard) -->
        <route-files value="osm.passenger.trips.xml"/>
        <!-- Buildings, lakes, parks: only for drawing in the GUI -->
        <additional-files value="osm.poly.xml.gz"/>
    </input>
    <time>
        <!-- Start at second 0, stop at second 3600 (1 hour) -->
        <begin value="0"/>
        <end value="3600"/>
    </time>
    <processing>
        <!-- Skip a car if its route is broken, instead of crashing -->
        <ignore-route-errors value="true"/>
        <!-- Traffic multiplier: 0.5 = half the cars, 2 = double. Used later for density experiments -->
        <scale value="1"/>
    </processing>
    <random_number>
        <!-- Same seed = exactly the same result every run (repeatable experiments) -->
        <seed value="42"/>
    </random_number>
    <report>
        <!-- Do not print SUMO's progress line every step -->
        <no-step-log value="true"/>
    </report>
    <gui_only>
        <!-- Colour/look settings for sumo-gui -->
        <gui-settings-file value="osm.view.xml"/>
    </gui_only>
</sumoConfiguration>
